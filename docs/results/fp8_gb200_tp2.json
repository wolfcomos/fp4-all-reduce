  "timing_method": {
    "fresh_sweeps": 3,
    "warmups_per_cell": 20,
    "paired_samples_per_cell_per_sweep": 200,
    "collectives_per_sample": 10,
    "timed_scope": "Full BF16-to-BF16 call including input quantization, communication, decode/reduction and internal synchronization. Compilation, allocation and one-float rank alignment are outside timing.",
    "per_sweep_statistic": "For sample i, max(rank0_event_us_i,rank1_event_us_i)/10; sort200 values and use index100 (upper median). Archived samples are already per-call microseconds.",
    "across_sweeps": "Median of the three sweep medians; range is min/max of these medians.",
    "speedups": "Median of three paired within-sweep ratios; never ratio of aggregate medians."
  },
  "accuracy_method": {
    "reference": "r_i=FP32_add_rn(FP32_add_rn(+0,float(x0_i)),float(x1_i)) for original BF16 inputs; no low-precision codec is applied to the reference.",
    "error": "e_i=float(y_i)-r_i",
    "relative_l2": "sqrt(mean(e_i**2)/mean(r_i**2)); if reference mean square is zero, use RMSE",
    "rmse": "sqrt(mean(e_i**2))",
    "max_abs": "max(abs(e_i))",
    "reduction_precision": "FP32 tensor subtraction, squares and means in PyTorch; host square root. These are measured metrics, not an FP64 error recomputation.",
    "aggregation": "One eager metric record per input_set and format. Eager/changed-graph/post-timing metrics were checked identical for the corresponding seed. All three sweeps gave identical metrics, so repeat copies are omitted. Ranges are min/max over the three seeds separately at each shape; no mean of relative-L2 ratios or pooling across shapes.",
    "pairing": "Joined by rows,backend,input_set and expected seed; source-index, generator hash, reference hash and common build/source maps verified across sweeps. Original tensors are not archived.",
    "scope": "Full-output error metrics. Independent FP8 codec and wire checks cover all groups for small tensors and sampled complete groups otherwise, supplemented by full-output finite/rank/graph/frozen-baseline and buffer-reuse gates.",
    "raw_field": "results[(rows,backend)].checks[(mode=eager,input_set)].error_vs_original_fp32_sum",
    "seed_count_per_shape_per_format": 3,
    "matching_eager_records_across_all_sweeps": 189
  },
